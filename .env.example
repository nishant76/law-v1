# Nikhar Environment Variables — Local Development Only
# For production, use Azure Key Vault

# Environment
ENVIRONMENT=development

# Database (docker-compose uses postgres service)
# Railway/Neon provide postgres:// or postgresql:// — the app converts it to asyncpg automatically
DATABASE_URL=postgresql+asyncpg://nikhar:nikhar@postgres:5432/nikhar
# For Railway/Neon, set DATABASE_URL to the connection string they provide, e.g.:
# DATABASE_URL=postgresql://user:password@host/dbname

# Redis (docker-compose uses redis service)
REDIS_URL=redis://redis:6379/0

# LLM Provider Selection
# Set to 'true' for Azure OpenAI (production, requires Azure setup)
# Set to 'false' for direct OpenAI API (local testing, requires OPENAI_API_KEY only)
USE_AZURE_OPENAI=true

# Direct OpenAI API (when USE_AZURE_OPENAI=false)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-<your-openai-api-key>
# Optional: Your OpenAI organization ID
OPENAI_ORG_ID=

# Azure OpenAI (when USE_AZURE_OPENAI=true)
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
GPT4O_DEPLOYMENT=gpt-4o
GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net/
AZURE_SEARCH_KEY=<your-search-service-admin-key>

# Azure Blob Storage
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

# SendGrid
SENDGRID_API_KEY=SG.<your-sendgrid-api-key>

# WhatsApp Business API (Meta)
WHATSAPP_API_TOKEN=<your-whatsapp-business-api-token>
WHATSAPP_PHONE_NUMBER_ID=<your-whatsapp-phone-number-id>

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/
